# Copy to .env and adjust. All values shown are the defaults.

# SECRET_KEY=change-me
# DATABASE_URL=sqlite+aiosqlite:///./solvary.db
# USE_MOCK_DB=false

# Execution: "mock" (no real execution) or "piston" (Docker, see README)
# EXECUTION_PROVIDER=mock
# PISTON_BASE_URL=http://localhost:2000

# EXECUTION_USER_CONCURRENCY=2
# EXECUTION_USER_RATE_PER_MIN=30

# Auth
# ENVIRONMENT=production          # fail-fast on unsafe config
# REFRESH_TOKEN_EXPIRE_DAYS=14
# GOOGLE_CLIENT_ID=<your-client>.apps.googleusercontent.com

# Scale-out backends: "memory" (single instance) or "redis"
# QUEUE_BACKEND=redis
# REALTIME_BACKPLANE=redis
# REDIS_URL=redis://localhost:6379/0

# AI assistant (POST /v1/assist/explain): "mock" or "openai" (any
# OpenAI-compatible server — matt_llm/serve.py on :8001, vLLM, OpenAI…)
# LLM_PROVIDER=mock
# LLM_BASE_URL=http://localhost:8001/v1
# LLM_API_KEY=no-key
# LLM_MODEL=matt-gpt
