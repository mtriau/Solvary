# Copy to .env and adjust. All values shown are the defaults.

# SECRET_KEY=change-me
# DATABASE_URL=sqlite+aiosqlite:///./solvary.db
# USE_MOCK_DB=false

# Execution: "mock" (no real execution) or "piston" (Docker, see README)
# EXECUTION_PROVIDER=mock
# PISTON_BASE_URL=http://localhost:2000

# EXECUTION_USER_CONCURRENCY=2
# EXECUTION_USER_RATE_PER_MIN=30

# Auth
# ENVIRONMENT=production          # fail-fast on unsafe config
# REFRESH_TOKEN_EXPIRE_DAYS=14
# GOOGLE_CLIENT_ID=<your-client>.apps.googleusercontent.com
